<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>JevNet.Extensions.DependencyInjection</AssemblyName>
    <RootNamespace>Jev</RootNamespace>
    <PackageId>JevNet.Extensions.DependencyInjection</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>JevNet dependency injection extensions</Title>
    <Description>Microsoft.Extensions.DependencyInjection integration for JevNet.</Description>
    <PackageTags>jev;typesafe-ai;dependency-injection;httpclient</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="../JevNet/JevNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
