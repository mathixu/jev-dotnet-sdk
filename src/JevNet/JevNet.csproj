<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>JevNet</AssemblyName>
    <RootNamespace>Jev</RootNamespace>
    <PackageId>JevNet</PackageId>
    <VersionPrefix>0.2.1</VersionPrefix>
    <Title>JevNet - .NET SDK for TypeSafe AI, Jev System One, and OpenRouter</Title>
    <Description>Typed .NET client SDK for TypeSafe AI's Jev System One and OpenRouter. Build structured AI decisions, classification, routing, scoring, and probability workflows.</Description>
    <PackageTags>jev;jevnet;typesafe-ai;openrouter;system-one;dotnet;csharp;ai;sdk;classification;routing;scoring;structured-output</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>Improved NuGet discoverability with clearer metadata, project links, a new package icon, and package-specific README documentation.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../assets/JevNet.png" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
